# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# =============================================================================
# JIRA API Configuration
# =============================================================================
# Your JIRA instance base URL (e.g., https://yourcompany.atlassian.net)
JIRA_BASE_URL=

# Your JIRA email/username
JIRA_USERNAME=

# Your JIRA API token (generate at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=

# JIRA project key (e.g., PROJ)
JIRA_PROJECT_KEY=

# =============================================================================
# Other Integrations (To be configured based on Discovery Q2)
# =============================================================================
# Example:
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# NOTION_API_KEY=
# NOTION_DATABASE_ID=

# =============================================================================
# Application Configuration
# =============================================================================
